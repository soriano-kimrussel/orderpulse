# Copy this file to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string. Use a MongoDB Atlas URI (free tier is fine) or any
# local mongod. Not needed for `npm run dev:memory`, which runs an in-memory database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orderpulse

# Secret used to sign JWTs. Use a long random string (at least 16 characters).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Shared secret used to verify the HMAC signature on POST /webhooks/orders.
WEBHOOK_SECRET=replace-with-another-long-random-string

# Origin of the React app, used for CORS and the Socket.IO handshake.
CLIENT_ORIGIN=http://localhost:5173

# Background webhook worker.
WORKER_ENABLED=true
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=5
